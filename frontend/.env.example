# Frontend environment variables
# Copy/rename to .env.local for local development (already in .gitignore)

# Backend API base URL (Vite dev-server proxy forwards /api calls too)
VITE_API_URL=http://localhost:8000/api

# Google OAuth Client ID – same value as GOOGLE_CLIENT_ID in backend/.env
# Leave empty to disable the Google sign-in button
VITE_GOOGLE_CLIENT_ID=
