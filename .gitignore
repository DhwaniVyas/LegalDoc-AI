*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-log.txt
pip-delete-this-directory.txt
.tox/
.cache
.pytest_cache/
htmlcov/
.coverage
*.cover
.hypothesis/
*.pyc

# Virtual environments
venv/
env/
ENV/
.venv/
backend/venv/
backend/.venv/

# SQLite database files
*.db
*.sqlite
*.sqlite3

# ── Node / Frontend ──────────────────────────────────────────
node_modules/
frontend/node_modules/
dist/
frontend/dist/
*.local
.npm

# ── Vite ─────────────────────────────────────────────────────
frontend/.vite/

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Uploads / temp files ─────────────────────────────────────
backend/uploads/
backend/temp/
backend/vector_store/


