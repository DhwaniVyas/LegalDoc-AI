# ============================================================
# LegalDoc AI – Environment Variables Example
# Copy this file to backend/.env and fill in real values.
# Never commit the .env file to Git.
# ============================================================

# ── AI / LLM ─────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Google OAuth ─────────────────────────────────────────────
# Obtain from https://console.cloud.google.com/ → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID of type "Web application"
# Add http://localhost:5173 and http://localhost:8000 to Authorized JavaScript origins
GOOGLE_CLIENT_ID=

# ── Authentication ───────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./legaldoc.db

# ── CORS / Frontend ──────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Cookie settings ──────────────────────────────────────────
# Set COOKIE_SECURE=true in production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=   # Leave empty for localhost

# ============================================================
# frontend/.env.local – Vite frontend variables
# ============================================================
# VITE_GOOGLE_CLIENT_ID=    (same value as GOOGLE_CLIENT_ID above)
# VITE_API_URL=http://localhost:8000/api
